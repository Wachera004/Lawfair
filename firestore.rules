rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Contracts collection rules
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // Disputes collection rules
    match /disputes/{disputeId} {
      allow read, write: if true;
    }

    // Lawyers collection rules
    match /lawyers/{lawyerId} {
      allow read, write: if true;
    }

    // Market Stats collection rules
    match /marketStats/{statId} {
      allow read, write: if true;
    }

    // SMS Logs collection rules
    match /smsLogs/{logId} {
      allow read, write: if true;
    }
  }
}
